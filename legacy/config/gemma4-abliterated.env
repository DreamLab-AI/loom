# Gemma 4 26B-A4B (it) — ARA-abliterated (uncensored), APEX-IQ quant
# Source: jenerallee78/gemma-4-26B-A4B-it-ara-abliterated (ARA = Adaptive Refusal
#   Abliteration, 2-pass SVD removal of refusal directions). Refusal rate ~7.7%.
# Architecture: gemma4 MoE (expert mixture, ~3.8B active of 26B), vision via mmproj.
# Role: DEFAULT uncensored model for general/personal use (hybrid plan, Path "Both").
# NOTE: This is an abliterated community quant — it is NOT Google QAT q4_0, so the
#   boxwrench QAT-matched MTP heads do NOT apply here and this GGUF ships no MTP
#   heads. It runs PLAIN decode. For the MTP speedups use the QAT "fast" endpoint
#   (config/gemma4-qat-mtp.env) instead.

HOST=0.0.0.0
# Default to 8082 so we DON'T clobber the qwen :8080 the email gateway depends on.
PORT=8082
GPU_LAYERS=999
# Default modest ctx so it can co-reside with qwen in spare VRAM for validation.
# For full 262144 you must free VRAM (swap qwen out) first — see README.
CTX_SIZE=32768
SPLIT_MODE=layer
REASONING_FORMAT=deepseek
PARALLEL=1
BATCH_SIZE=4096
UBATCH_SIZE=2048
THREADS=24

# q8_0 KV: fastest AND highest tail-fidelity on this hw (q5_0 is ~1.6x slower here —
# no fast FA kernel for gemma4 head dims). Hadamard rotation auto-on. Use q5_0 only
# to squeeze longer context when q8_0 KV won't fit VRAM.
EXTRA_ARGS="--cache-type-k q8_0 --cache-type-v q8_0"
