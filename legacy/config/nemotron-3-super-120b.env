# Nemotron-3-Super-120B-A12B (UD-IQ4_XS) — Unsloth's llama.cpp fork required
# Architecture: Mamba-2 + MoE + Attention hybrid (120B total, 12B active)
# Mamba layers = no KV cache, enabling longer context on limited VRAM
# Temperature MUST be 1.0 for reasoning and tool calling (per NVIDIA docs)

HOST=0.0.0.0
PORT=8080
GPU_LAYERS=999
CTX_SIZE=262144
SPLIT_MODE=layer
REASONING_FORMAT=none
PARALLEL=1
BATCH_SIZE=4096
UBATCH_SIZE=2048
THREADS=24

# KV cache compression (q8_0) to maximize context length
# flash-attn required for long context performance
EXTRA_ARGS="--cache-type-k q8_0 --cache-type-v q8_0"
