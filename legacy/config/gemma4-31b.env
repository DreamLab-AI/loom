# Gemma 4 31B (DENSE) it — official QAT, Unsloth UD-Q4_K_XL — the network's dense Gemma on :8084
# Main:  unsloth/gemma-4-31B-it-qat-GGUF  (UD-Q4_K_XL, ~17.3GB)  QAT ⇒ 4-bit ≈ bf16 quality.
# Draft: mtp-gemma-4-31B-it.gguf — Multi-Token-Prediction head, speculative decode.
# Vision: mmproj-BF16.gguf (SigLIP) — this dense 31B is multimodal.
# Engine: MAINLINE ggml-org/llama.cpp built for TURING sm_75. Update via scripts/update-llama.sh
#   (rebuild with -DCMAKE_CUDA_ARCHITECTURES=75 for these cards, NOT 89/Ada).
#
# HARDWARE: 2x Quadro RTX 6000 (Turing, sm_75, 24GB each = 48GB aggregate). The model +
# 128K f16 KV (~36GB) does NOT fit one 24GB card, so we SPLIT across both GPUs (layer split).
# NVLink reported INACTIVE (topo shows PCIe/NODE), so layer split (low interconnect) not row.

HOST=0.0.0.0
PORT=8084
# Both GPUs. Layer-split spreads the ~36GB over 2x24GB (~18GB/card).
CUDA_DEVICE=0,1
SPLIT_MODE=layer
MAIN_GPU=0
CTX_SIZE=262144
PARALLEL=4
# Unified KV (all slots share the pool) so one request can use the full 256K, instead
# of -c being divided by PARALLEL. Set KV_UNIFIED=0 to isolate slots.
KV_UNIFIED=1
# q8_0 KV (near-lossless, ~half of f16) lets 256K (model max) fit in ~the same VRAM that
# 128K f16 used. Use f16 for pristine KV but then cap context ~160K on these 24GB cards.
KV_TYPE=q8_0
# Unsloth/Google recommended Gemma 4 sampling.
TEMP=1.0
TOP_P=0.95
TOP_K=64
# Speculative decode: mtp | off
SPEC=mtp
DRAFT_N_MAX=4
# Vision on (set VISION=0 to skip mmproj).
VISION=1
