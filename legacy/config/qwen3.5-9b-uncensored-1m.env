# Qwen3.5-9B-Uncensored-HauhauCS-Aggressive (Q8_0) with Vision + 1M Context
# Hybrid architecture: 3x linear attention + 1x full attention per block
# Linear attention layers are efficient for long context (no quadratic KV scaling)

HOST=0.0.0.0
PORT=8080
GPU_LAYERS=999
CTX_SIZE=1048576
SPLIT_MODE=layer
REASONING_FORMAT=none
PARALLEL=1
BATCH_SIZE=4096
UBATCH_SIZE=2048
THREADS=24

# Extra args: vision encoder + YaRN RoPE scaling for 1M context
# rope_theta=10000000 is baked into the GGUF, no need to override rope-freq-base
# YaRN factor 4 extends 262K native -> ~1M context
EXTRA_ARGS="--mmproj /home/john/githubs/llm-server/models/Qwen3.5-9B-Uncensored/mmproj-Qwen3.5-9B-Uncensored-HauhauCS-Aggressive-BF16.gguf --rope-scaling yarn --rope-scale 4 --rope-freq-base 10000000 --yarn-orig-ctx 262144 --cache-type-k q8_0 --cache-type-v q8_0"
