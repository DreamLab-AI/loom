# Muse Glimmer 30B (dense + vision) — Meta Superintelligence Labs, Apache-2.0
# bartowski Q8_0 (~28GB, near-lossless 8-bit) — the network's agentic model on :8085.
# (Unsloth UD-Q8_K_XL had broken chat metadata; bartowski's re-quant works. mmproj+dflash = official.)
# Draft: dflash-kquant.gguf — DFlash block-diffusion drafter (block=16), speculative decode.
# Vision: mmproj-kquant.gguf (perception encoder, ViT-G/14).
# Engine: MAINLINE ggml-org/llama.cpp built for TURING sm_75 (muse_glimmer arch merged b10342+).
#   Rebuild with -DCMAKE_CUDA_ARCHITECTURES=75 for these cards, NOT 89/Ada.
#
# HARDWARE: 2x Quadro RTX 6000 (Turing, sm_75, 24GB each = 48GB aggregate). Q8 weights (32.3GB)
# + DFlash drafter + vision + KV do NOT fit one 24GB card, so we LAYER-SPLIT across both GPUs.
# Muse Glimmer's HYBRID attention (39/52 layers are sliding-window 2048; only ~13 global layers
# hold full context) makes the KV cache cheap — that's why Q8 + large context fits in 48GB.
# NVLink INACTIVE (bridge doesn't fit board spacing) -> layer split (low interconnect), not row.

HOST=0.0.0.0
PORT=8085
# Both GPUs, layer-split (~21GB/card for weights+drafter+vision, KV shared).
CUDA_DEVICE=0,1
SPLIT_MODE=layer
MAIN_GPU=0
# 262144 (full) via YaRN rope-scaling (below). Native trained ctx is 131072; llama.cpp clamps
# -c to that unless we rope-scale + override the ctx-length KV. Set CTX_SIZE=131072 + ROPE_SCALING=none
# to run native (safest). VRAM at 256K ≈ low-30s GB of 48.
CTX_SIZE=262144
# Single-stream for the trial (cleanest throughput, lowest VRAM). Raise once headroom is measured.
PARALLEL=1
# Unified KV so a single request can use the full -c even at PARALLEL>1 (not divided by --parallel).
KV_UNIFIED=1
# q8_0 KV: near-lossless, ~half of f16. Hybrid SWA already keeps KV small.
KV_TYPE=q8_0
# Meta/Unsloth recommended Muse Glimmer sampling.
TEMP=1.0
TOP_P=0.95
TOP_K=64
# Speculative decode: dflash | off  (DFlash block-diffusion drafter, block size 16 -> max 15).
SPEC=dflash
DRAFT_N_MAX=15
# YaRN context extension 131072 -> 262144 (2x). EXPERIMENTAL (community params, not officially
# validated). ROPE_SCALING=none to disable. rope-scale 2 = CTX_SIZE/YARN_ORIG_CTX.
ROPE_SCALING=yarn
ROPE_SCALE=2
YARN_ORIG_CTX=131072
# Vision on (set VISION=0 to skip mmproj).
VISION=1
