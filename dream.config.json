{
  "repo": "DreamLab-AI/loom",
  "cron": "0 3 * * *",
  "annexeInclude": [
    "ruvector"
  ],
  "slots": [
    {
      "deep": "scaffold-retrieval",
      "scan": [
        "ontology-proxy",
        "budget-clamping"
      ]
    },
    {
      "deep": "model-facade",
      "scan": [
        "chat-completions",
        "model-passthrough"
      ]
    },
    {
      "deep": "confidence-injection",
      "scan": [
        "grounding-scores",
        "selective-injection"
      ]
    },
    {
      "deep": "graph-engine",
      "scan": [
        "pyoxigraph",
        "triple-loading"
      ]
    }
  ],
  "bonusModuli": {
    "30": "benchmark-methodology",
    "60": "deployment-hardening"
  },
  "controlPlaneProbes": [
    "bash scripts/dream-health.sh || echo 'FACADE UNREACHABLE'",
    "ls crates/loom-facade/src/bin/*.rs crates/loom-scaffold/src/bin/*.rs crates/loom-vector-ruvector/src/bin/*.rs 2>&1 | head -15 || true",
    "ls -d ../ruvector/crates/ruvector-core 2>&1 || echo 'SIBLING ruvector ABSENT'"
  ],
  "buildStep": {
    "cmd": "bash scripts/dream-build.sh",
    "degradeOnWasmFailure": true
  },
  "evaluatorEntrypoints": {
    "graph": "bash scripts/dream-eval.sh graph-check",
    "confidence": "bash scripts/dream-eval.sh confidence-check",
    "generation": "bash scripts/dream-eval.sh generation-check",
    "contract": "cargo test -q -p loom-facade --test contract_live 2>&1 | tail -30",
    "mirror": "cargo test -q -p loom-facade --test mirror_generation 2>&1 | tail -20"
  },
  "competitors": [
    "LangChain RAG",
    "LlamaIndex",
    "Haystack",
    "DSPy"
  ],
  "adrConvention": "3-digit",
  "extraDisciplines": [
    "evaluation-is-not-promotion",
    "witness-every-quantitative-claim",
    "scaffold-is-the-product-not-prose"
  ],
  "ledgerPath": "docs/dream-cycle/LEDGER.md",
  "branchPrefix": "dream/",
  "labels": [
    "dream-cycle",
    "research"
  ],
  "autoMerge": false
}
