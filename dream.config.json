{
  "repo": "DreamLab-AI/loom",
  "cron": "0 3 * * *",
  "slots": [
    {
      "deep": "scaffold-retrieval",
      "scan": ["ontology-proxy", "budget-clamping"]
    },
    {
      "deep": "model-facade",
      "scan": ["chat-completions", "model-passthrough"]
    },
    {
      "deep": "confidence-injection",
      "scan": ["grounding-scores", "selective-injection"]
    },
    {
      "deep": "graph-engine",
      "scan": ["pyoxigraph", "triple-loading"]
    }
  ],
  "bonusModuli": {
    "30": "benchmark-methodology",
    "60": "deployment-hardening"
  },
  "controlPlaneProbes": [
    "python3 -c 'import pyoxigraph; print(f\"pyoxigraph {pyoxigraph.__version__}\")' 2>&1 || true",
    "ls app/*.py tests/*.py bench/*.py 2>&1 | head -15 || true"
  ],
  "buildStep": {
    "cmd": "python3 -c 'import pyoxigraph; print(f\"pyoxigraph {pyoxigraph.__version__}\")' 2>&1 && cd app/ontology-mcp && npm ci --ignore-scripts 2>&1 | tail -5 || true",
    "degradeOnWasmFailure": true
  },
  "evaluatorEntrypoints": {
    "bench": "cd tests && python3 -m pytest -v 2>&1 | tail -30"
  },
  "competitors": ["LangChain RAG", "LlamaIndex", "Haystack", "DSPy"],
  "adrConvention": "3-digit",
  "extraDisciplines": [
    "evaluation-is-not-promotion",
    "witness-every-quantitative-claim",
    "scaffold-is-the-product-not-prose"
  ],
  "ledgerPath": "docs/dream-cycle/LEDGER.md",
  "branchPrefix": "dream/",
  "labels": ["dream-cycle", "research"],
  "autoMerge": false
}
