app/data/
*.venv/
.venv/
**/node_modules/
**/__pycache__/
uplift-results/
*.pyc
# local agent-tooling state (not project artifacts)
.agentic-qe/
.claude-flow/
# LaTeX build intermediates (keep .tex/.bib and the built report.pdf)
docs/research/latex/*.aux
docs/research/latex/*.bbl
docs/research/latex/*.blg
docs/research/latex/*.log
docs/research/latex/*.out
