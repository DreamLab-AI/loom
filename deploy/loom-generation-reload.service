[Unit]
Description=Verify and reload a newly published Loom generation

[Service]
Type=oneshot
ExecStart=%h/githubs/loom/target/release/reload_published_generation --data-dir %h/githubs/loom/data --receipt %h/.local/state/loom/reload.json --url http://127.0.0.1:8084 -- /usr/bin/docker compose -f %h/githubs/loom/deploy/compose.profile-a.yml up -d --no-deps --force-recreate loom
TimeoutStartSec=150
UMask=0077
NoNewPrivileges=true
