\@writefile{toc}{\contentsline {paragraph}{The placebo had to be verified irrelevant.}{10}{section*.29}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Signed gain over copy for all ten models, negative throughout, with per-model seeded 10{,}000-resample bootstrap 95\% intervals (whiskers); the value column at right gives each point and interval. No model's interval crosses zero, and none exceeds the copy ceiling on the lexical metric; the spread ($-0.067$ to $-0.022$) is the axis that separates them where the near-identical raw uplift does not. Models nearest zero (top) restate the vetted facts most faithfully.}}{11}{figure.caption.25}\protected@file@percent }
\newlabel{fig:gain}{{4}{11}{Signed gain over copy for all ten models, negative throughout, with per-model seeded 10{,}000-resample bootstrap 95\% intervals (whiskers); the value column at right gives each point and interval. No model's interval crosses zero, and none exceeds the copy ceiling on the lexical metric; the spread ($-0.067$ to $-0.022$) is the axis that separates them where the near-identical raw uplift does not. Models nearest zero (top) restate the vetted facts most faithfully}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Study~2 paired judged-quality deltas (Qwen3.8-27B, model held constant, loom versus raw serving path; cross-family GPT judge), per set and pooled, with seeded 10{,}000-resample bootstrap 95\% intervals. The three sets are ordered by curation depth: the effect is largest on the deep \emph  {arcane} set ($+0.79$), attenuates on the sparsely-covered \emph  {thin} set ($+0.30$), and is negligible out-of-domain on \emph  {general} ($+0.05$). That monotone gradient, large where curation is deep and vanishing where the corpus is thin or the question off-domain, is the signature a genuine grounding effect should show and not what a uniform prompt-formatting artefact would produce. The shaded band is the pre-specified $\pm 0.25$ TOST equivalence margin: the general-set interval $[0.00,+0.13]$ sits wholly inside it, so out-of-domain non-regression is read by CI-inclusion, not from a non-significant difference (\S  \ref {sec:live}, \S  \ref {sec:ood}).}}{11}{figure.caption.26}\protected@file@percent }
\newlabel{fig:forest}{{5}{11}{Study~2 paired judged-quality deltas (Qwen3.8-27B, model held constant, loom versus raw serving path; cross-family GPT judge), per set and pooled, with seeded 10{,}000-resample bootstrap 95\% intervals. The three sets are ordered by curation depth: the effect is largest on the deep \emph {arcane} set ($+0.79$), attenuates on the sparsely-covered \emph {thin} set ($+0.30$), and is negligible out-of-domain on \emph {general} ($+0.05$). That monotone gradient, large where curation is deep and vanishing where the corpus is thin or the question off-domain, is the signature a genuine grounding effect should show and not what a uniform prompt-formatting artefact would produce. The shaded band is the pre-specified $\pm 0.25$ TOST equivalence margin: the general-set interval $[0.00,+0.13]$ sits wholly inside it, so out-of-domain non-regression is read by CI-inclusion, not from a non-significant difference (\S \ref {sec:live}, \S \ref {sec:ood})}{figure.caption.26}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Study~2, the production-node paired study: Qwen3.8-27B, model held constant, loom versus raw serving path, judged $0$--$5$ by a cross-family GPT judge. Paired mean difference with seeded 10{,}000-resample bootstrap 95\% CI, two-sided Wilcoxon $p$ (Holm-adjusted across the three sets), the matched-pairs rank-biserial $r$ (paired effect size, conditioned on non-tied pairs), and win/loss/tie counts. Complete-case after budget-exhaustion re-runs (\S  \ref {sec:results}).}}{12}{table.caption.27}\protected@file@percent }
\newlabel{tab:live}{{5}{12}{Study~2, the production-node paired study: Qwen3.8-27B, model held constant, loom versus raw serving path, judged $0$--$5$ by a cross-family GPT judge. Paired mean difference with seeded 10{,}000-resample bootstrap 95\% CI, two-sided Wilcoxon $p$ (Holm-adjusted across the three sets), the matched-pairs rank-biserial $r$ (paired effect size, conditioned on non-tied pairs), and win/loss/tie counts. Complete-case after budget-exhaustion re-runs (\S \ref {sec:results})}{table.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Negative-control decomposition (Study~2, pooled arcane\,$+$\,thin, judged $0$--$5$ by the cross-family GPT judge), each arm holding the model and question fixed and perturbing only the injected block, read as a paired contrast against the bare model (arm\,$-$\,raw) with seeded bootstrap 95\% intervals. Read top to bottom the ladder is the paper's central negative control: the served block lifts quality (\emph  {true}\,$-$\,raw $+0.59$, the one significant contrast, in teal), masking the seed-class names ($+0.42$) or shuffling the body sentences ($+0.25$) costs comparatively little, and an equally well-formed, on-corpus scaffold drawn from a \emph  {different} question shows a near-zero point estimate (\emph  {irrelevant}\,$-$\,raw $+0.04$). That near-zero placebo is consistent with the lift being specific to scaffold \emph  {content} rather than the mere presence of ontology-shaped text, though its wide interval under attrition means inertness is not demonstrated by equivalence; the content-specific residual is \emph  {true}\,$-$\,\emph  {irrelevant} $=+0.35$ $[0.00,+0.78]$. The arms are complete-case over unequal survivor sets and all but \emph  {true} are non-significant with wide intervals, so the attribution rests on the pattern across arms, not any single contrast (\S  \ref {sec:controls}).}}{12}{figure.caption.28}\protected@file@percent }
\newlabel{fig:controls}{{6}{12}{Negative-control decomposition (Study~2, pooled arcane\,$+$\,thin, judged $0$--$5$ by the cross-family GPT judge), each arm holding the model and question fixed and perturbing only the injected block, read as a paired contrast against the bare model (arm\,$-$\,raw) with seeded bootstrap 95\% intervals. Read top to bottom the ladder is the paper's central negative control: the served block lifts quality (\emph {true}\,$-$\,raw $+0.59$, the one significant contrast, in teal), masking the seed-class names ($+0.42$) or shuffling the body sentences ($+0.25$) costs comparatively little, and an equally well-formed, on-corpus scaffold drawn from a \emph {different} question shows a near-zero point estimate (\emph {irrelevant}\,$-$\,raw $+0.04$). That near-zero placebo is consistent with the lift being specific to scaffold \emph {content} rather than the mere presence of ontology-shaped text, though its wide interval under attrition means inertness is not demonstrated by equivalence; the content-specific residual is \emph {true}\,$-$\,\emph {irrelevant} $=+0.35$ $[0.00,+0.78]$. The arms are complete-case over unequal survivor sets and all but \emph {true} are non-significant with wide intervals, so the attribution rests on the pattern across arms, not any single contrast (\S \ref {sec:controls})}{figure.caption.28}{}}
