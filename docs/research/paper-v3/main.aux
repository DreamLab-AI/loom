\@writefile{toc}{\contentsline {paragraph}{The headline is delivery fidelity, and the instrument is what reveals it.}{12}{section*.32}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Negative-control contrasts, pooled arcane\,$+$\,thin, judged $0$--$5$, paired mean difference with seeded bootstrap 95\% CI and two-sided Wilcoxon $p$. Complete-case over surviving pairs; the control arms were not retried at the larger budget, so $n$ varies by arm (\S  \ref {sec:results}). Read top to bottom: the serving path adds nothing (loom$-$true~$\approx 0$); the served block lifts quality (true$-$raw); the same-shaped placebo does not (irrelevant$-$raw~$\approx 0$); the content-specific residual is true$-$irrelevant.}}{13}{table.caption.30}\protected@file@percent }
\newlabel{tab:controls}{{6}{13}{Negative-control contrasts, pooled arcane\,$+$\,thin, judged $0$--$5$, paired mean difference with seeded bootstrap 95\% CI and two-sided Wilcoxon $p$. Complete-case over surviving pairs; the control arms were not retried at the larger budget, so $n$ varies by arm (\S \ref {sec:results}). Read top to bottom: the serving path adds nothing (loom$-$true~$\approx 0$); the served block lifts quality (true$-$raw); the same-shaped placebo does not (irrelevant$-$raw~$\approx 0$); the content-specific residual is true$-$irrelevant}{table.caption.30}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Out-of-domain non-regression (five-model judged arm): paired harness$-$bare quality delta (judge $0$--$5$ vs frontier gold), five models, seeded paired bootstrap 95\% CI. Every interval includes zero. The worst case is off-domain questions where the confidence gate mis-fired and injected anyway; the last row is where it correctly skipped.}}{13}{table.caption.31}\protected@file@percent }
\newlabel{tab:ood}{{7}{13}{Out-of-domain non-regression (five-model judged arm): paired harness$-$bare quality delta (judge $0$--$5$ vs frontier gold), five models, seeded paired bootstrap 95\% CI. Every interval includes zero. The worst case is off-domain questions where the confidence gate mis-fired and injected anyway; the last row is where it correctly skipped}{table.caption.31}{}}
\@writefile{toc}{\contentsline {paragraph}{The live controls point to content, not form.}{13}{section*.33}\protected@file@percent }
