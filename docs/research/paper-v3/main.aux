\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Ten models, one deterministic configuration, $n=510$ (seed 42), sorted by gain over copy (scaffold recall $-$ copy ceiling). The copy ceiling (0.964) is a property of the questions and the injected context and is identical across models. The interval shown is the domain-clustered block bootstrap (the wider, primary one).}}{10}{table.caption.23}\protected@file@percent }
\newlabel{tab:sweep}{{3}{10}{Ten models, one deterministic configuration, $n=510$ (seed 42), sorted by gain over copy (scaffold recall $-$ copy ceiling). The copy ceiling (0.964) is a property of the questions and the injected context and is identical across models. The interval shown is the domain-clustered block bootstrap (the wider, primary one)}{table.caption.23}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Exposure/recovery decomposition over the 510-question sweep ($1{,}136$ gold items per model; $11{,}360$ pooled), sorted by context utilisation. Utilisation is $n_{11}/(n_{11}+n_{10})$, the fraction of \emph  {exposed} gold the answer recovers; $n_{10}$ is exposed gold the answer omitted; $n_{01}$ is gold recovered though the scaffold did not expose it. Across all ten models $n_{01}$ never exceeds 1, and is 3 pooled: recovery beyond exposure is empirically negligible. Counts are pooled over gold items (micro-averaged), whereas the headline recall and ceiling average per-question ratios (macro-averaged), so these counts do not reconstruct those numbers directly.}}{10}{table.caption.24}\protected@file@percent }
\newlabel{tab:decomp}{{4}{10}{Exposure/recovery decomposition over the 510-question sweep ($1{,}136$ gold items per model; $11{,}360$ pooled), sorted by context utilisation. Utilisation is $n_{11}/(n_{11}+n_{10})$, the fraction of \emph {exposed} gold the answer recovers; $n_{10}$ is exposed gold the answer omitted; $n_{01}$ is gold recovered though the scaffold did not expose it. Across all ten models $n_{01}$ never exceeds 1, and is 3 pooled: recovery beyond exposure is empirically negligible. Counts are pooled over gold items (micro-averaged), whereas the headline recall and ceiling average per-question ratios (macro-averaged), so these counts do not reconstruct those numbers directly}{table.caption.24}{}}
